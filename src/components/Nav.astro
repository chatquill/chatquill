---
// Nav renders on every page. Category filtering is handled client-side via JS.
---

<nav class="sticky top-0 z-[100] flex items-center justify-between gap-6 h-[58px] px-[clamp(16px,5vw,48px)] border-b border-[#1e2d3d]" id="site-nav">
  <a href="/" class="font-display font-bold text-xl text-[#e4eff8] tracking-[0.5px] shrink-0 leading-none">
    chat<span class="text-[#00e5a0]">quill</span>
  </a>

  <div class="nav-links-scroll flex items-center gap-1.5" id="nav-links">
    {(['All', 'AI', 'Tech', 'Data Science', 'Beginner'] as const).map((label) => {
      const cat = label === 'All' ? 'all' : label;
      return (
        <button
          class="nav-link font-mono text-[11px] tracking-[0.5px] text-[#7a90a4] px-2.5 py-[5px] rounded-[3px] cursor-pointer transition-colors duration-150 hover:text-[#e4eff8] hover:bg-[#161f2c] whitespace-nowrap"
          data-cat={cat}
        >
          {label}
        </button>
      );
    })}
  </div>

  <!-- spacer balances logo on desktop; hidden on mobile to give filters full width -->
  <div class="w-6 shrink-0 hidden sm:block" />
</nav>

<style>
  #site-nav {
    background: rgba(13, 17, 23, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .nav-link.active {
    color: #00e5a0;
  }

  /* Scrollable filter strip on mobile — no links hidden */
  .nav-links-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }
  .nav-links-scroll::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  @media (max-width: 640px) {
    .nav-links-scroll {
      gap: 6px;
    }
    .nav-link {
      font-size: 10px;
      padding: 4px 8px;
    }
  }
</style>
