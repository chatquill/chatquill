---
const path = Astro.url.pathname;
const isArticles = path === '/' || path.startsWith('/blog');
const isSkills = path.startsWith('/skills');
const isContact = path.startsWith('/contact');
const current = (active: boolean) => (active ? 'page' : undefined);
---

<div class="top-hairline" aria-hidden="true"></div>

<nav class="site-nav" id="site-nav" aria-label="Primary">
  <a href="/" class="wordmark">
    <img src="/images/logo-circle.png" alt="" width="52" height="52" class="wordmark-logo" />
    <span>chat<span class="wordmark-accent">quill</span></span>
  </a>

  <div class="nav-links">
    <a href="/" class:list={['nav-page-link', isArticles && 'active']} aria-current={current(path === '/')}>articles</a>
    <a href="/skills" class:list={['nav-page-link', isSkills && 'active']} aria-current={current(isSkills)}>skills</a>
    <a href="/contact" class:list={['nav-page-link', isContact && 'active']} aria-current={current(isContact)}>get in touch</a>
  </div>

  <button class="hamburger" id="menu-toggle" aria-label="Open menu" aria-haspopup="dialog" aria-expanded="false">[menu]</button>
</nav>

<!-- Native dialog: Escape, focus trap, inert page and focus return come for free -->
<dialog class="mobile-menu" id="mobile-menu" aria-label="Menu">
  <button class="mobile-close" id="menu-close" aria-label="Close menu">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
  </button>
  <a href="/" class="mobile-nav-link">articles</a>
  <a href="/skills" class="mobile-nav-link">skills</a>
  <a href="/contact" class="mobile-nav-link">get in touch</a>
</dialog>

<style>
  .top-hairline {
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, theme('colors.border.2') 20%, theme('colors.border.2') 80%, transparent 100%);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 101;
  }

  .site-nav {
    position: sticky;
    top: 1px;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding: 0 clamp(16px, 5vw, 56px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(13, 17, 23, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .wordmark {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0.5px;
    color: theme('colors.off-white');
    text-decoration: none;
    line-height: 1;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .wordmark-logo {
    width: 52px;
    height: 52px;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 0 4px rgba(0, 229, 160, 0.5));
    transform: translateX(10%);
  }

  .wordmark-accent {
    color: theme('colors.accent.DEFAULT');
    font-style: italic;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .nav-page-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: theme('colors.off-white');
    text-decoration: none;
    transition: color 150ms;
  }

  .nav-page-link:hover,
  .nav-page-link.active {
    color: theme('colors.accent.DEFAULT');
  }

  .hamburger {
    display: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: theme('colors.off-white');
    background: none;
    border: none;
    cursor: pointer;
    min-height: 44px;
    padding: 4px 8px;
  }

  .mobile-menu {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: theme('colors.bg.DEFAULT');
  }

  .mobile-menu[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  :global(html:has(.mobile-menu[open])) {
    overflow: hidden;
  }

  .mobile-nav-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.4rem;
    color: theme('colors.off-white');
    text-decoration: none;
    padding: 10px 20px;
    transition: color 150ms;
  }

  .mobile-nav-link:hover {
    color: theme('colors.accent.DEFAULT');
  }

  .mobile-close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: theme('colors.dim');
    background: none;
    border: none;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .hamburger { display: block; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;

  toggle?.addEventListener('click', () => {
    menu?.showModal();
    toggle.setAttribute('aria-expanded', 'true');
  });

  document.getElementById('menu-close')?.addEventListener('click', () => menu?.close());
  menu?.addEventListener('close', () => toggle?.setAttribute('aria-expanded', 'false'));
</script>
