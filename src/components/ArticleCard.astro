---
interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  readtime: string;
  date: string;
  coverGradient: string;
  coverGlow: string;
  coverImage?: string;
}

const { slug, title, description, tags, readtime, date, coverGradient, coverGlow, coverImage } = Astro.props;
---

<article
  class="card group bg-bg-2 border border-border rounded-[4px] overflow-hidden cursor-pointer flex flex-col transition-all duration-200 hover:border-border-2 hover:-translate-y-[3px] hover:shadow-[0_12px_40px_rgba(0,0,0,0.4)]"
  data-cats={tags.join(',')}
>
  <a href={`/blog/${slug}`} class="flex flex-col flex-1">
    <!-- Cover image area -->
    <div class="w-full overflow-hidden shrink-0" style="aspect-ratio: 1600/840;">
      {coverImage ? (
        <img
          src={coverImage}
          alt=""
          width="1600"
          height="840"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover transition-transform duration-[400ms] ease-in-out group-hover:scale-[1.04]"
        />
      ) : (
        <div
          class="w-full h-full relative transition-transform duration-[400ms] ease-in-out group-hover:scale-[1.04]"
          style={`background: ${coverGradient};`}
        >
          <div
            class="absolute inset-0"
            style={`background: radial-gradient(ellipse at 60% 40%, ${coverGlow} 0%, transparent 60%);`}
          ></div>
          <span class="absolute left-4 right-4 bottom-4 font-display font-bold italic text-white/90 leading-[1.25] text-[clamp(12px,1.8vw,18px)]" aria-hidden="true">
            {title}
          </span>
        </div>
      )}
    </div>

    <!-- Card body -->
    <div class="flex flex-col gap-2 p-[18px_20px_20px] flex-1">
      <!-- Tags are labels, not controls, so they stay quiet -->
      <div class="flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <span class="font-mono text-[11px] uppercase tracking-[1.5px] text-dim border border-border-2 px-[7px] py-[2px] rounded-[2px]">
            {t}
          </span>
        ))}
      </div>
      <h3 class="font-display font-bold text-[17px] text-off-white leading-[1.35] transition-colors duration-200 group-hover:text-accent" style="text-wrap: pretty;">
        {title}
      </h3>
      <p class="text-[13px] text-dim leading-[1.5] line-clamp-2">
        {description}
      </p>
      <div class="flex items-center gap-2 font-mono text-[11px] text-dim mt-auto pt-1">
        <span>Mohun S.A.</span>
        <span aria-hidden="true">·</span>
        <span>{date}</span>
        <span aria-hidden="true">·</span>
        <span>{readtime}</span>
      </div>
    </div>
  </a>
</article>

<style>
  /* The card clips its children, so the focus ring goes on the card itself */
  .card a:focus-visible {
    outline: none;
  }

  .card:has(a:focus-visible) {
    outline: 2px solid #00e5a0;
    outline-offset: 2px;
  }
</style>
