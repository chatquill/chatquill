---
interface Props {
  showBack?: boolean;
}
const { showBack = false } = Astro.props;
---

<footer class="border-t border-border px-[clamp(16px,5vw,48px)] py-8 flex items-center justify-between flex-wrap gap-4">
  <a href="/" class="font-display text-base font-bold text-dim hover:text-off-white transition-colors duration-150 py-2.5">
    {showBack ? '← chatquill' : 'chatquill'}
  </a>
  <p class="font-mono text-[11px] text-dim tracking-[0.5px]">
    © 2026 Mohun Shakeel Ahmad · Mauritius
  </p>
</footer>
