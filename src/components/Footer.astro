---
interface Props {
  showBack?: boolean;
}
const { showBack = false } = Astro.props;
---

<footer class="border-t border-[#1e2d3d] px-[clamp(16px,5vw,48px)] py-10 flex items-center justify-between flex-wrap gap-4">
  {showBack ? (
    <a href="/" class="font-display text-base font-bold text-[#7a90a4] hover:text-[#e4eff8] transition-colors duration-150 cursor-pointer">
      ← chatquill
    </a>
  ) : (
    <a href="/" class="font-display text-base font-bold text-[#7a90a4] hover:text-[#e4eff8] transition-colors duration-150">
      chatquill
    </a>
  )}
  <p class="font-mono text-[10px] text-[#3d5166] tracking-[0.5px]">
    © 2026 Mohun Shakeel Ahmad · Mauritius
  </p>
</footer>
