---
interface Props {
  src?: string;
  caption?: string;
  alt?: string;
}
const { src, caption, alt = '' } = Astro.props;
---

<figure class="my-9">
  <div class="w-full bg-bg-3 border border-border rounded-[4px] overflow-hidden" style="aspect-ratio: 16/9;">
    {src ? (
      <a href={src} class="block w-full h-full" aria-label={`Open full-size image${alt ? `: ${alt}` : ''}`}>
        <img src={src} alt={alt} loading="lazy" decoding="async" class="w-full h-full object-contain" />
      </a>
    ) : (
      <div class="w-full h-full flex items-center justify-center flex-col gap-2 py-12 px-6">
        <slot>
          <!-- Optional: pass an <img> tag as child, or leave empty for placeholder -->
          <div class="w-10 h-[30px] border border-muted/50 rounded-[3px] opacity-50"
            style="background: repeating-linear-gradient(135deg, transparent, transparent 4px, #1e2d3d 4px, #1e2d3d 5px);"
          ></div>
          {alt && <span class="font-mono text-[11px] text-dim tracking-[0.5px] text-center">{alt}</span>}
        </slot>
      </div>
    )}
  </div>
  {caption && (
    <figcaption class="mt-2.5 font-body italic text-[13px] text-dim text-center leading-[1.5]">
      {caption}
    </figcaption>
  )}
</figure>
