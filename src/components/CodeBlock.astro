---
import { Code } from 'astro:components';

interface Props {
  filename?: string;
  lang?: string;
  code: string;
}

const { filename, lang = 'text', code } = Astro.props;
---

<div class="my-8 rounded-[4px] overflow-hidden border border-border">
  {filename && (
    <div class="flex items-center justify-between px-4 py-2 bg-bg-3 border-b border-border">
      <span class="font-mono text-[11px] text-dim flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-[1px] bg-accent opacity-70 shrink-0"></span>
        {filename}
      </span>
      <span class="font-mono text-[11px] text-dim uppercase tracking-[1px]">{lang}</span>
    </div>
  )}
  <div class="bg-[#080d14] overflow-x-auto">
    <Code code={code.trim()} lang={lang.toLowerCase()} theme="github-dark-dimmed" />
  </div>
</div>
