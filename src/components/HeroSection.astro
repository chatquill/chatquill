---
interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  readtime: string;
  date: string;
  coverGradient: string;
  coverGlow: string;
  coverImage?: string;
}

const { slug, title, description, tags, readtime, date, coverGradient, coverGlow, coverImage } = Astro.props;
---

<section class="hero" data-cats={tags.join(',')}>
  <div class="hero-text">
    <div class="flex items-center gap-2 mb-4 flex-wrap">
      {tags.map((t) => (
        <span class="font-mono text-[11px] uppercase tracking-[1.5px] text-bg bg-accent px-2 py-[3px] rounded-[2px] font-semibold">
          {t}
        </span>
      ))}
    </div>

    <h1 class="font-display font-bold text-[clamp(26px,3.2vw,44px)] text-off-white leading-[1.15] mb-4" style="text-wrap: balance;">
      <a href={`/blog/${slug}`} class="hero-link">{title}</a>
    </h1>

    <p class="text-[16px] text-body leading-[1.65] mb-5 max-w-[52ch]">{description}</p>

    <div class="flex items-center gap-x-5 gap-y-1 font-mono text-[11px] text-dim mb-5 flex-wrap">
      <span>Mohun Shakeel Ahmad</span>
      <span>{date}</span>
      <span>{readtime}</span>
    </div>

    <span class="hero-cta" aria-hidden="true">Read article <span>→</span></span>
  </div>

  <div class="hero-cover">
    {coverImage ? (
      <img src={coverImage} alt="" width="1600" height="840" fetchpriority="high" />
    ) : (
      <div class="w-full h-full relative" style={`background: ${coverGradient};`}>
        <div class="absolute inset-0" style={`background: radial-gradient(ellipse at 20% 60%, ${coverGlow} 0%, transparent 55%);`}></div>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(28px, 4vw, 56px) clamp(16px, 5vw, 48px);
    border-bottom: 1px solid theme('colors.border.DEFAULT');
  }

  /* The title link covers the whole block, so the cover is clickable too */
  .hero-link {
    transition: color 200ms;
  }

  .hero-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .hero:hover .hero-link {
    color: theme('colors.accent.DEFAULT');
  }

  .hero-link:focus-visible {
    outline: none;
  }

  .hero:has(.hero-link:focus-visible) {
    outline: 2px solid theme('colors.accent.DEFAULT');
    outline-offset: -2px;
  }

  .hero-cta {
    display: inline-flex;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.5px;
    color: theme('colors.accent.DEFAULT');
    border-bottom: 1px solid theme('colors.accent.DEFAULT');
    padding-bottom: 1px;
  }

  .hero-cta span {
    transition: transform 200ms;
  }

  .hero:hover .hero-cta span {
    transform: translateX(4px);
  }

  .hero-cover {
    aspect-ratio: 1600 / 840;
    border: 1px solid theme('colors.border.DEFAULT');
    border-radius: 4px;
    overflow: hidden;
  }

  .hero-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero:hover .hero-cover img {
    transform: scale(1.02);
  }

  @media (max-width: 1100px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-cover {
      order: -1;
    }
  }
</style>
