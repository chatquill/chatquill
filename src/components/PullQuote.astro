---
interface Props {
  cite?: string;
}
const { cite } = Astro.props;
---

<blockquote class="my-10 py-6 border-y border-border">
  <p class="font-display italic text-[22px] text-off-white leading-[1.45] m-0">
    <slot />
  </p>
  {cite && (
    <cite class="block mt-3 font-mono text-[11px] text-dim not-italic">
      — {cite}
    </cite>
  )}
</blockquote>
