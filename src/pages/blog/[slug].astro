---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { sortPostsByDateDesc } from '../../utils/sort';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, tags, readtime, date, coverGradient, coverGlow, coverImage, description } = post.data;

// Keep reading: newest posts that share a tag first, then the newest of the rest
const others = sortPostsByDateDesc(await getCollection('blog')).filter((p) => p.slug !== post.slug);
const sharesTag = (p: CollectionEntry<'blog'>) => p.data.tags.some((t) => tags.includes(t));
const related = [...others.filter(sharesTag), ...others.filter((p) => !sharesTag(p))].slice(0, 2);
---

<BaseLayout title={`${title} — ChatQuill`} description={description} image={coverImage}>
  <Nav />

  <main id="main">
    <!-- Article title ABOVE the cover image -->
    <header class="max-w-[740px] mx-auto px-[clamp(16px,5vw,48px)] pt-10 pb-8">
      <div class="flex items-center gap-2.5 mb-5 flex-wrap">
        {tags.map((t) => (
          <span class="font-mono text-[11px] uppercase tracking-[1.5px] text-bg bg-accent px-[9px] py-[3px] rounded-[2px] font-semibold">
            {t}
          </span>
        ))}
        <span class="font-mono text-[11px] text-dim">{readtime}</span>
        <span class="font-mono text-[11px] text-dim">· {date}</span>
      </div>

      <h1
        class="font-display font-bold text-[clamp(26px,4vw,42px)] text-off-white leading-[1.2] mb-6"
        style="text-wrap: pretty;"
      >
        {title}
      </h1>

      <div class="flex items-center gap-3">
        <div aria-hidden="true" class="w-10 h-10 rounded-full bg-bg-4 border border-muted flex items-center justify-center font-display text-sm font-bold text-accent shrink-0">
          M
        </div>
        <div>
          <div class="font-display text-sm font-semibold text-off-white">Mohun Shakeel Ahmad</div>
          <div class="font-mono text-[11px] text-dim mt-0.5">
            Software Engineer @ SharinPix · MSc Data Science, Sunway University
          </div>
        </div>
      </div>
    </header>

    <!-- Cover: a little wider than the text column, so the first paragraph stays close to the title -->
    <div class="max-w-[900px] mx-auto px-[clamp(16px,5vw,48px)] mb-10">
      <div class="w-full overflow-hidden border border-border rounded-[4px]" style="aspect-ratio: 1600/840;">
      {coverImage ? (
        <img src={coverImage} alt="" width="1600" height="840" fetchpriority="high" class="w-full h-full object-cover" />
      ) : (
        <div class="w-full h-full relative" style={`background: ${coverGradient};`}>
          <div
            class="absolute inset-0"
            style={`background: radial-gradient(ellipse at 40% 60%, ${coverGlow} 0%, transparent 65%);`}
          ></div>
        </div>
      )}
      </div>
    </div>

    <!-- Article body -->
    <article class="article-body max-w-[740px] mx-auto px-[clamp(16px,5vw,48px)] pb-20">
      <Content />
    </article>

    <section class="max-w-[900px] mx-auto px-[clamp(16px,5vw,48px)] pb-16" aria-labelledby="keep-reading">
      <h2 class="font-mono text-[11px] font-normal uppercase tracking-[2px] text-dim mb-6" id="keep-reading">Keep reading</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {related.map((p) => (
          <ArticleCard
            slug={p.slug}
            title={p.data.title}
            description={p.data.description}
            tags={p.data.tags}
            readtime={p.data.readtime}
            date={p.data.date}
            coverGradient={p.data.coverGradient ?? ''}
            coverGlow={p.data.coverGlow ?? ''}
            coverImage={p.data.coverImage}
          />
        ))}
      </div>
    </section>

    <AuthorBio />
  </main>

  <Footer showBack />
</BaseLayout>

<script>
  // Tables scroll sideways on narrow screens; make that scroll reachable by keyboard
  document.querySelectorAll('.article-body table').forEach((table) => {
    table.setAttribute('tabindex', '0');
    table.setAttribute('role', 'region');
    table.setAttribute('aria-label', 'Table, scrolls sideways');
  });
</script>

<style>
  /* Prose styles scoped to .article-body */
  /* Let long URLs / unbroken strings wrap instead of widening the page */
  .article-body {
    overflow-wrap: break-word;
  }

  .article-body :global(p) {
    font-size: 17px;
    line-height: 1.85;
    color: #b8ccdb;
    margin-bottom: 22px;
    text-wrap: pretty;
    font-family: 'Lora', Georgia, serif;
  }

  .article-body :global(h2) {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 24px;
    font-weight: 700;
    color: #e4eff8;
    margin: 40px 0 16px;
    line-height: 1.3;
  }

  .article-body :global(h3) {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 19px;
    font-weight: 600;
    color: #e4eff8;
    margin: 32px 0 12px;
  }

  .article-body :global(strong) {
    color: #e4eff8;
    font-weight: 600;
  }

  .article-body :global(em) {
    font-style: italic;
    color: #b8ccdb;
  }

  .article-body :global(a) {
    color: #00e5a0;
    border-bottom: 1px solid #00c488;
    transition: opacity 0.15s;
  }

  .article-body :global(a:hover) {
    opacity: 0.75;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    color: #b8ccdb;
    font-size: 17px;
    line-height: 1.85;
    margin-bottom: 22px;
    padding-left: 1.5rem;
    font-family: 'Lora', Georgia, serif;
  }

  /* Tailwind's reset removes list markers; prose needs them back */
  .article-body :global(ul) {
    list-style: disc;
  }

  .article-body :global(ol) {
    list-style: decimal;
  }

  .article-body :global(li::marker) {
    color: #7a90a4;
  }

  .article-body :global(li) {
    margin-bottom: 8px;
  }

  /* inline code */
  .article-body :global(code:not(pre > code)) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85em;
    color: #00e5a0;
    background: rgba(0, 229, 160, 0.08);
    padding: 1px 5px;
    border-radius: 3px;
  }

  /* Shiki code blocks from standard markdown fences */
  .article-body :global(pre) {
    margin: 32px 0;
    border-radius: 4px;
    border: 1px solid #1e2d3d;
    overflow-x: auto;
  }

  /* Markdown tables */
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 32px 0;
    font-family: 'Lora', Georgia, serif;
    font-size: 15px;
    line-height: 1.55;
  }
  .article-body :global(th) {
    background: #161f2c;
    color: #e4eff8;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    padding: 10px 14px;
    border: 1px solid #1e2d3d;
    text-align: left;
    letter-spacing: 0.3px;
  }
  .article-body :global(td) {
    padding: 9px 14px;
    border: 1px solid #1e2d3d;
    color: #b8ccdb;
  }
  .article-body :global(tr:nth-child(even) td) {
    background: #0d1520;
  }
  /* On narrow screens, scroll wide tables inside the column rather than
     widening the page (iOS Safari zooms out and leaves a gap on the right) */
  @media (max-width: 740px) {
    .article-body :global(table) {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }

  /* Blockquotes */
  .article-body :global(blockquote) {
    margin: 40px 0;
    padding: 24px 0;
    border-top: 1px solid #1e2d3d;
    border-bottom: 1px solid #1e2d3d;
  }
  .article-body :global(blockquote p) {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 19px !important;
    font-style: italic;
    color: #e4eff8 !important;
    line-height: 1.5 !important;
    margin: 0 !important;
  }

  /* H1 inside article body (user-authored) — hide since it's above the cover now */
  .article-body :global(h1) {
    display: none;
  }

  /* Horizontal rules */
  .article-body :global(hr) {
    border: none;
    border-top: 1px solid #1e2d3d;
    margin: 40px 0;
  }
</style>
