---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AuthorBio from '../../components/AuthorBio.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, tag, readtime, date, coverGradient, coverGlow, description } = post.data;
---

<BaseLayout title={`${title} — ChatQuill`} description={description}>
  <Nav />

  <main class="page-enter">
    <!-- Full-bleed cover -->
    <div class="w-full overflow-hidden" style="aspect-ratio: 1600/840;">
      <div
        class="w-full h-full relative"
        style={`background: ${coverGradient};`}
      >
        <div
          class="absolute inset-0"
          style={`background: radial-gradient(ellipse at 40% 60%, ${coverGlow} 0%, transparent 65%);`}
        ></div>
      </div>
    </div>

    <!-- Article header -->
    <header class="max-w-[740px] mx-auto px-[clamp(16px,5vw,48px)] pt-9 pb-7">
      <div class="flex items-center gap-2.5 mb-4">
        <span class="font-mono text-[10px] uppercase tracking-[1.5px] text-[#0d1117] bg-[#00e5a0] px-[9px] py-[3px] rounded-[2px] font-semibold">
          {tag}
        </span>
        <span class="font-mono text-[11px] text-[#7a90a4]">{readtime}</span>
        <span class="font-mono text-[11px] text-[#3d5166]">{date}</span>
      </div>

      <h1
        class="font-display font-bold text-[clamp(26px,4vw,42px)] text-[#e4eff8] leading-[1.2] mb-5"
        style="text-wrap: pretty;"
      >
        {title}
      </h1>

      <div class="flex items-center gap-3 pb-6 border-b border-[#1e2d3d]">
        <div class="w-10 h-10 rounded-full bg-[#1c2739] border border-[#3d5166] flex items-center justify-center font-display text-sm font-bold text-[#00e5a0] shrink-0">
          M
        </div>
        <div>
          <div class="font-display text-sm font-semibold text-[#e4eff8]">Mohun Shakeel Ahmad</div>
          <div class="font-mono text-[10px] text-[#7a90a4] mt-0.5">
            Software Engineer @ SharinPix · MSc Data Science, Sunway University
          </div>
        </div>
      </div>
    </header>

    <!-- Article body -->
    <article class="article-body max-w-[740px] mx-auto px-[clamp(16px,5vw,48px)] pb-20">
      <Content />
    </article>

    <AuthorBio />
    <Footer showBack />
  </main>
</BaseLayout>

<style>
  /* Prose styles scoped to .article-body */
  .article-body :global(p) {
    font-size: 17px;
    line-height: 1.85;
    color: #b8ccdb;
    margin-bottom: 22px;
    text-wrap: pretty;
    font-family: 'Lora', Georgia, serif;
  }

  .article-body :global(h2) {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 24px;
    font-weight: 700;
    color: #e4eff8;
    margin: 40px 0 16px;
    line-height: 1.3;
  }

  .article-body :global(h3) {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 19px;
    font-weight: 600;
    color: #e4eff8;
    margin: 32px 0 12px;
  }

  .article-body :global(strong) {
    color: #e4eff8;
    font-weight: 600;
  }

  .article-body :global(em) {
    font-style: italic;
    color: #b8ccdb;
  }

  .article-body :global(a) {
    color: #00e5a0;
    border-bottom: 1px solid #00c488;
    transition: opacity 0.15s;
  }

  .article-body :global(a:hover) {
    opacity: 0.75;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    color: #b8ccdb;
    font-size: 17px;
    line-height: 1.85;
    margin-bottom: 22px;
    padding-left: 1.5rem;
    font-family: 'Lora', Georgia, serif;
  }

  .article-body :global(li) {
    margin-bottom: 8px;
  }

  /* inline code */
  .article-body :global(code:not(pre > code)) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: #00e5a0;
    background: rgba(0, 229, 160, 0.08);
    padding: 1px 5px;
    border-radius: 3px;
  }

  /* Shiki code blocks from standard markdown fences */
  .article-body :global(pre) {
    margin: 32px 0;
    border-radius: 4px;
    border: 1px solid #1e2d3d;
    overflow-x: auto;
  }
</style>
