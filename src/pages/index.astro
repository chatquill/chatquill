---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TopicsSidebar from '../components/TopicsSidebar.astro';
import { getEffectiveFeatured, sortPostsByDateDesc } from '../utils/sort';

const posts = sortPostsByDateDesc(await getCollection('blog'));

const featured = getEffectiveFeatured(posts)!;
// The hero already shows the featured post, so the grid lists the rest
const gridPosts = posts.filter((p) => p !== featured);

const topicDefs = [
  { key: 'all',          label: 'All' },
  { key: 'AI',           label: 'AI' },
  { key: 'Tech',         label: 'Tech' },
  { key: 'Data Science', label: 'Data Science' },
  { key: 'Beginner',     label: 'Beginner' },
];

const topics = topicDefs.map((t) => ({
  ...t,
  count: t.key === 'all'
    ? posts.length
    : posts.filter((p) => p.data.tags.includes(t.key as any)).length,
}));
---

<BaseLayout>
  <Nav />

  <!-- Mobile topic chip row (hidden on ≥769px) -->
  <div class="mobile-chips" id="mobile-chips">
    {topics.map((t) => (
      <button class="chip" data-cat={t.key} aria-pressed="false">
        {t.label}
        <span class="chip-count">{String(t.count).padStart(2, '0')}</span>
      </button>
    ))}
  </div>

  <div class="page-layout">
    <TopicsSidebar topics={topics} />

    <main class="content-area" id="main">
      <HeroSection
        slug={featured.slug}
        title={featured.data.title}
        description={featured.data.description}
        tags={featured.data.tags}
        readtime={featured.data.readtime}
        date={featured.data.date}
        coverGradient={featured.data.coverGradient ?? ''}
        coverGlow={featured.data.coverGlow ?? ''}
        coverImage={featured.data.coverImage}
      />

      <!-- Section header -->
      <div class="flex items-center justify-between gap-4 px-[clamp(16px,5vw,48px)] pt-10 pb-6">
        <div class="flex items-baseline gap-3 flex-wrap">
          <h2 class="font-mono text-[11px] font-normal uppercase tracking-[2px] text-dim" id="grid-label">Recent Articles</h2>
          <span class="font-mono text-[11px] text-dim" id="filter-status" aria-live="polite"></span>
        </div>
        <button class="view-all" id="view-all" hidden>View all →</button>
      </div>

      <!-- Card grid -->
      <div
        class="grid gap-6 px-[clamp(16px,5vw,48px)] pb-16"
        id="card-grid"
        style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));"
      >
        {gridPosts.map((post) => (
          <ArticleCard
            slug={post.slug}
            title={post.data.title}
            description={post.data.description}
            tags={post.data.tags}
            readtime={post.data.readtime}
            date={post.data.date}
            coverGradient={post.data.coverGradient ?? ''}
            coverGlow={post.data.coverGlow ?? ''}
            coverImage={post.data.coverImage}
          />
        ))}
      </div>

      <p class="px-[clamp(16px,5vw,48px)] pb-16 text-[15px] text-dim" id="empty-state" hidden>
        No articles in this topic yet.
      </p>

      <!-- Author bio -->
      <section class="border-t border-border px-[clamp(16px,5vw,48px)] py-10">
        <div class="flex items-start gap-5 max-w-3xl">
          <div class="w-12 h-12 rounded-full bg-bg-4 border-2 border-accent flex items-center justify-center font-display text-lg font-bold text-accent shrink-0 mt-0.5" aria-hidden="true">
            M
          </div>
          <div>
            <div class="flex items-baseline gap-3 flex-wrap mb-1">
              <span class="font-display font-bold text-off-white text-[17px]">Mohun Shakeel Ahmad</span>
              <span class="font-mono text-[11px] text-dim tracking-[0.3px]">Software Engineer @ SharinPix · MSc Data Science · Mauritius</span>
            </div>
            <p class="text-[14px] text-dim leading-[1.65] max-w-[580px]">
              Code that ships. Data that matters. Writing that doesn't waste your time.
            </p>
          </div>
        </div>
      </section>
    </main>
  </div>

  <Footer />
</BaseLayout>

<style>
  .page-layout {
    display: flex;
    align-items: flex-start;
  }

  .content-area {
    flex: 1;
    min-width: 0;
  }

  .view-all {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #00e5a0;
    background: none;
    border: none;
    cursor: pointer;
    min-height: 44px;
    padding: 0 4px;
    transition: opacity 150ms;
  }

  .view-all:hover {
    opacity: 0.7;
  }

  /* Mobile chip row: sticks under the nav so the active filter stays in view */
  .mobile-chips {
    display: none;
    position: sticky;
    top: 65px;
    z-index: 50;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 8px;
    padding: 6px 48px 6px clamp(16px, 5vw, 48px);
    background: #0d1117;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    /* Fade the right edge to hint that the row scrolls */
    mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent);
  }

  .mobile-chips::-webkit-scrollbar {
    display: none;
  }

  .chip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: #b8ccdb;
    background: #161f2c;
    border: 1px solid #1e2d3d;
    border-radius: 99px;
    min-height: 44px;
    padding: 0 14px;
    cursor: pointer;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 150ms, border-color 150ms;
    flex-shrink: 0;
  }

  .chip.active {
    color: #00e5a0;
    border-color: #00e5a0;
  }

  .chip-count {
    font-size: 11px;
    color: #7a90a4;
  }

  .chip.active .chip-count {
    color: #00e5a0;
  }

  @media (max-width: 768px) {
    .mobile-chips {
      display: flex;
    }
  }
</style>

<script>
  // Category selectors (sidebar links + mobile chips) and the things they filter (hero + cards)
  const selectors = document.querySelectorAll<HTMLElement>('[data-cat]');
  const items = document.querySelectorAll<HTMLElement>('[data-cats]');
  const known = new Set([...selectors].map((el) => el.dataset.cat));

  const label = document.getElementById('grid-label');
  const status = document.getElementById('filter-status');
  const viewAll = document.getElementById('view-all');
  const empty = document.getElementById('empty-state');

  function render(requested: string) {
    const cat = known.has(requested) ? requested : 'all';

    selectors.forEach((el) => {
      const on = el.dataset.cat === cat;
      el.classList.toggle('active', on);
      if (el instanceof HTMLButtonElement) el.setAttribute('aria-pressed', String(on));
      else if (on) el.setAttribute('aria-current', 'true');
      else el.removeAttribute('aria-current');
    });

    let shown = 0;
    items.forEach((item) => {
      const show = cat === 'all' || (item.dataset.cats?.split(',') ?? []).includes(cat);
      item.style.display = show ? '' : 'none';
      if (show) shown++;
    });

    if (label) label.textContent = cat === 'all' ? 'Recent Articles' : cat;
    if (status) status.textContent = cat === 'all' ? '' : `${shown} ${shown === 1 ? 'article' : 'articles'}`;
    if (viewAll) viewAll.hidden = cat === 'all';
    if (empty) empty.hidden = shown > 0;
    return cat;
  }

  function setActive(requested: string) {
    const cat = render(requested);
    const url = new URL(window.location.href);
    if (cat === 'all') url.searchParams.delete('cat');
    else url.searchParams.set('cat', cat);
    // pushState so the browser Back button undoes a filter
    if (url.href !== window.location.href) window.history.pushState(null, '', url);
  }

  const fromUrl = () => new URLSearchParams(window.location.search).get('cat') ?? 'all';

  render(fromUrl());
  window.addEventListener('popstate', () => render(fromUrl()));

  selectors.forEach((el) => {
    el.addEventListener('click', (e) => {
      // Sidebar links are <a> tags — prevent navigation, handle client-side
      e.preventDefault();
      setActive(el.dataset.cat ?? 'all');
    });
  });

  viewAll?.addEventListener('click', () => setActive('all'));
</script>
