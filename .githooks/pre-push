#!/bin/sh
# Runs lint, unit tests, and E2E tests before every push.
# Push is blocked if any check fails.

# Block direct pushes to master — use a PR instead.
while read local_ref local_sha remote_ref remote_sha; do
  if echo "$remote_ref" | grep -qE '^refs/heads/master$'; then
    echo ""
    echo "PUSH BLOCKED: Direct pushes to master are not allowed."
    echo "Create a branch and open a Pull Request on GitHub instead."
    echo ""
    exit 1
  fi
done

echo ""
echo "Running pre-push checks..."
echo "============================================"

# Lint
echo ""
echo "[1/3] Lint (ESLint)"
echo "--------------------------------------------"
npm run lint
LINT_EXIT=$?

if [ $LINT_EXIT -ne 0 ]; then
  echo ""
  echo "PUSH BLOCKED: Lint failed."
  echo "Fix the errors above before pushing."
  echo ""
  exit 1
fi

# Unit tests
echo ""
echo "[2/3] Unit tests (Vitest)"
echo "--------------------------------------------"
npm test
UNIT_EXIT=$?

if [ $UNIT_EXIT -ne 0 ]; then
  echo ""
  echo "PUSH BLOCKED: Unit tests failed."
  echo "Fix the failures above before pushing."
  echo ""
  exit 1
fi

# E2E tests
echo ""
echo "[3/3] E2E tests (Playwright)"
echo "--------------------------------------------"
npm run test:e2e
E2E_EXIT=$?

if [ $E2E_EXIT -ne 0 ]; then
  echo ""
  echo "PUSH BLOCKED: E2E tests failed."
  echo "Fix the failures above before pushing."
  echo ""
  exit 1
fi

echo ""
echo "All checks passed. Pushing..."
echo ""
exit 0
